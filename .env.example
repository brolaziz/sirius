# Firebase web config — safe to commit values in a real deploy, but keep .env.local
# out of git so each dev points at their own project.
# Get these from Firebase console > Project settings > Your apps > SDK setup (Config).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
