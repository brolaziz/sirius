// =============================================================================
// Sirius — Prisma schema
// =============================================================================
// Prisma 7 notes (differs from v5/v6):
//   * The generator is `prisma-client` (not `prisma-client-js`) and requires an
//     explicit `output`. The client is emitted to `lib/generated/prisma` and is
//     imported as `@/lib/generated/prisma` — never from `@prisma/client`.
//   * `datasource.url` is NOT declared here. The connection string is supplied
//     by `prisma.config.ts` (which reads `DATABASE_URL` via dotenv).
//   * At runtime the client is constructed with a driver adapter
//     (`@prisma/adapter-pg`). See `lib/prisma.ts`.
//
// Field naming: models use idiomatic camelCase in TypeScript and are `@map`ped
// to snake_case columns, so the database reads the way the spec describes it
// (`target_score`, `passage_text`, …) while application code stays idiomatic.
//
// Apply this schema with:  npx prisma db push
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Which part of the Digital SAT a test covers.
/// `FULL` is a complete adaptive test (Reading & Writing + Math).
enum TestType {
  READING
  MATH
  FULL
}

/// The Digital SAT is section-adaptive: every section has two modules, and
/// performance in module 1 determines the difficulty of module 2.
enum TestModule {
  MODULE_1
  MODULE_2
}

/// Digital SAT questions are either 4-option multiple choice or SPR
/// ("student-produced response" — the student types a numeric answer).
enum QuestionFormat {
  MULTIPLE_CHOICE
  SPR
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// The decision an admissions office returned.
/// Where a student is in school. Sirius is built for 15–18 year olds, so the
/// useful answer is a year rather than an age — a year says how many admissions
/// cycles are left, which an age does not.
enum GradeLevel {
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  GRADUATED
}

/// What the student came here for. It decides what the dashboard leads with,
/// not what they are allowed to use.
enum StudyPriority {
  SAT
  ADMISSIONS
  BOTH
}

/// How a practice session was started. It decides where finishing it sends
/// the student back to, and whether a study-plan task gets credited.
enum PracticeSource {
  SKILL
  PLAN
  /// Mixed practice: questions drawn across every topic, so the session has no
  /// single skill. `PracticeSession.skillId` is null for these.
  MIXED
}

enum ApplicationStatus {
  ACCEPTED
  REJECTED
  WAITLISTED
}

/// Lifecycle of an attempt, so an interrupted session can be resumed.
enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// -----------------------------------------------------------------------------
// Users
// -----------------------------------------------------------------------------

/// A Sirius student, and the row Auth.js owns.
///
/// The first five fields are Auth.js's contract with `@auth/prisma-adapter` and
/// must keep those exact names — the adapter writes them directly. Everything
/// below `targetScore` is ours. `@map` only renames the *column*, so the
/// database still reads in snake_case while the adapter sees what it expects.
///
/// The row is created by the adapter on first Google sign-in; `lib/user.ts`
/// then reads it and seeds the starter roadmap on the first authenticated
/// request.
model User {
  id String @id @default(cuid())

  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  /// The score the student is aiming for (400–1600), used by the dashboard to
  /// frame progress. Null until the student sets a goal.
  targetScore Int? @map("target_score")

  /*
   * What onboarding asks, in the order it asks it.
   *
   * Every one of these is nullable and every one is written the moment its step
   * is answered, so a student who closes the tab on step 3 comes back to step 3
   * rather than to the beginning. `onboardingCompletedAt` is what says the
   * whole flow finished — a set of non-null columns cannot, because "I don't
   * know my score" is a real answer that leaves `currentScore` null.
   */
  gradeLevel GradeLevel? @map("grade_level")

  /// Most recent real or practice score, 400–1600. Null means the student does
  /// not know it yet, which routes them to a diagnostic rather than to a guess.
  currentScore Int? @map("current_score")

  /// The date of the exam they are working towards. Adopted column: it was in
  /// the database before onboarding existed.
  targetExamDate DateTime? @map("target_exam_date")

  /// How much time a week they say they can give this. Drives the plan's weekly
  /// question count. Adopted column, and its default is deliberate: five hours
  /// a week is the assumption the plan falls back on.
  weeklyStudyMinutes Int @default(300) @map("weekly_study_minutes")

  priority StudyPriority?

  /// Set when the last step is answered. Until then the app shows onboarding
  /// instead of the dashboard.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  /// Preferred UI language. Sirius is bilingual (Uzbek / English).
  locale String @default("uz")

  /*
   * Paid access. A single boolean on purpose: Sirius has one paid tier, and
   * modelling plans, periods and renewals before there is a payment provider
   * would be inventing a billing system nobody has designed.
   *
   * It gates *content* — the essay library — and never the study tools. It is
   * checked in server code (see `lib/premium.ts`); a locked card in the browser
   * is a courtesy, not the lock.
   */
  isPremium Boolean @default(false) @map("is_premium")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  results       TestResult[]
  attempts      TestAttempt[]
  savedWords    SavedWord[]
  roadmapTasks  RoadmapTask[]
  studyPlans    StudyPlan[]
  practice      PracticeSession[]
  activities    UserActivity[]
  shortlist     UniversityShortlistEntry[]

  @@map("users")
}

/// An OAuth account linked to a user. Written by `@auth/prisma-adapter`.
///
/// The snake_case *field* names here are deliberate and must not be
/// camelCased: they are the raw OAuth response keys the adapter stores by name.
/// Google's `id_token` is a JWT and comfortably exceeds the default varchar, so
/// every token column is `@db.Text`.
model Account {
  id String @id @default(cuid())

  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// A database-backed session. Sirius uses the database strategy rather than
/// JWTs so that signing out actually invalidates the session server-side.
model Session {
  id String @id @default(cuid())

  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Required by the adapter's contract. Unused while Google is the only
/// provider — it backs email/passwordless flows, which we may add later.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// Content taxonomy
// -----------------------------------------------------------------------------

/// Which half of the Digital SAT a domain belongs to.
///
/// Deliberately not `TestType`: that enum describes a *test* and has a third
/// value (`FULL`) no domain can take. `RW` is this enum's spelling of Reading
/// & Writing.
enum SatSection {
  RW
  MATH
}

/// A College Board content domain — the top level of the skill taxonomy.
///
/// ADOPTED, NOT INVENTED. These rows were already in the database when the
/// question bank arrived: 8 domains and 31 skills, bilingual, carrying the
/// share of the exam each part is worth. Recreating a thinner taxonomy
/// alongside them would have left the database holding two answers to the same
/// question, so this schema describes what is there.
///
/// `examWeight` is that share as a fraction of the whole test (0.175 = 17.5%),
/// which is what lets a study plan spend a student's time where the exam
/// actually spends its questions.
///
/// The rows are content, not user data: `lib/taxonomy.ts` holds the closed list
/// of `code` values a question may be filed under, and the names and weights
/// live here and nowhere else.
model Domain {
  id String @id @default(cuid())

  /// Stable key, e.g. "MATH_ALGEBRA". The taxonomy in `lib/taxonomy.ts` refers
  /// to domains and skills by code, never by name.
  code String @unique

  name   String
  nameUz String? @map("name_uz")

  section SatSection

  /// Share of the whole exam, as a fraction: 0.175 = 17.5% of all questions.
  examWeight Float @map("exam_weight")

  /// Display order within its section, following the College Board's own.
  order Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skills Skill[]

  @@index([section, order])
  @@map("domains")
}

/// A skill inside a domain — the unit practice, roadmaps and weak-area analysis
/// are measured in.
///
/// `weightInDomain` is this skill's share *of its domain* (the values in one
/// domain sum to 1), so a question's share of the exam is
/// `domain.examWeight * skill.weightInDomain`.
///
/// `baseQuestionsToMastery` is how many questions a student is expected to need
/// before this skill can be called learned. It came with these rows, from the
/// mastery model that was removed from the application; it is untouched and
/// unread for now, and is the natural input when that work returns.
model Skill {
  id String @id @default(cuid())

  /// Stable key, e.g. "RW_CRAFT_WORDS_IN_CONTEXT".
  code String @unique

  name   String
  nameUz String? @map("name_uz")

  domainId String @map("domain_id")
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  /// Share of its domain, as a fraction. The skills in one domain sum to 1.
  weightInDomain Float @map("weight_in_domain")

  /// Questions a student is expected to need before this skill is learned.
  baseQuestionsToMastery Int @map("base_questions_to_mastery")

  order Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions Question[]

  /// Weekly practice this skill has been scheduled for.
  planTasks StudyPlanTask[]

  /// Practice sessions run against this skill.
  practiceSessions PracticeSession[]

  /// Skills this one depends on.
  prerequisites SkillPrerequisite[] @relation("SkillPrerequisiteSkill")

  /// Skills that depend on this one.
  requiredFor SkillPrerequisite[] @relation("SkillPrerequisitePrerequisite")

  @@index([domainId, order])
  @@map("skills")
}

/// "You cannot sensibly practise A before B" — one edge of the prerequisite
/// graph. 29 of these came with the taxonomy; nothing reads them yet, and a
/// study plan that orders topics by dependency is what they are for.
model SkillPrerequisite {
  skillId String @map("skill_id")
  skill   Skill  @relation("SkillPrerequisiteSkill", fields: [skillId], references: [id], onDelete: Cascade)

  prerequisiteId String @map("prerequisite_id")
  prerequisite   Skill  @relation("SkillPrerequisitePrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([skillId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("skill_prerequisites")
}

// -----------------------------------------------------------------------------
// Tests & questions
// -----------------------------------------------------------------------------

/// A practice test or single module.
///
/// Content is authored elsewhere and loaded through `POST /api/tests/import`.
/// `externalId` is the caller's own identifier for the test; it is unique so
/// re-importing the same payload updates the existing test instead of
/// duplicating it (idempotent import).
model Test {
  id String @id @default(cuid())

  externalId  String?  @unique @map("external_id")
  title       String
  description String?
  type        TestType @default(FULL)

  /// Only published tests are visible to students.
  isPublished Boolean @default(false) @map("is_published")

  /// Time limit for the whole test, in minutes. The Digital SAT allots 32
  /// minutes per Reading & Writing module and 35 per Math module.
  durationMinutes Int @default(32) @map("duration_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions Question[]
  results   TestResult[]
  attempts  TestAttempt[]

  @@index([isPublished, type])
  @@map("tests")
}

/// A single question, optionally paired with a reading passage.
///
/// `options` is JSON so the importer can accept the caller's own shape. The
/// canonical form is an array of `{ label, text }`:
///   [{ "label": "A", "text": "…" }, { "label": "B", "text": "…" }]
/// A bare `string[]` is also accepted and normalised to labels A–D on import.
/// See `lib/validation/test-import.ts`.
model Question {
  id String @id @default(cuid())

  testId String @map("test_id")
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  /// Caller-supplied id, unique per test, so re-imports update in place.
  externalId String? @map("external_id")

  /// 1-based position within the test.
  order Int @default(1)

  module TestModule @default(MODULE_1)

  /// The reading passage / stimulus shown in the left pane of the simulator.
  /// Null for most Math questions, which are self-contained.
  passageText  String? @map("passage_text")
  passageTitle String? @map("passage_title")

  questionText String         @map("question_text")
  format       QuestionFormat @default(MULTIPLE_CHOICE)

  /// Answer choices. Empty/absent for SPR questions.
  options Json?

  /// For MULTIPLE_CHOICE this is the option label ("A"…"D").
  /// For SPR it is the canonical accepted answer as a string ("3/4", "0.75").
  /// This is the form shown to the student on the results screen, so it holds
  /// one value even when several are accepted — the alternatives live in
  /// `acceptedAnswers`.
  correctAnswer String @map("correct_answer")

  /// Every form of the answer a student may type, for SPR questions. Source
  /// banks write these as one string ("0.35 or 7/20"); the importer splits them
  /// so the grader compares against a list instead of parsing prose. Empty for
  /// multiple choice, where the label in `correctAnswer` is the whole answer.
  ///
  /// The grader also accepts arithmetically equal forms (`7/20` for `0.35`),
  /// so this does not have to enumerate every rounding — see `lib/sat.ts`.
  acceptedAnswers String[] @default([]) @map("accepted_answers")

  explanation String?

  /*
   * Taxonomy. Three kinds of column, and the distinction between them matters:
   *
   *   skillId      THE AUTHORITATIVE LINK, to a `Skill` row. Roadmaps,
   *                weak-area analysis and practice selection read this and
   *                nothing else.
   *   domain/skill Denormalised display labels, copied from the taxonomy rows
   *                at import time so the simulator can label a question
   *                without joining two tables on every render. Never group by
   *                these: they are text, and text drifts.
   *   sourceTopic  The raw `topic` string from the source file, kept verbatim
   *                so a bad mapping can be found later. Never read by product
   *                code.
   *
   * The relation field is `skillRef` rather than `skill` only because the
   * cached label already occupies that name.
   */
  skillId  String? @map("skill_id")
  skillRef Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)

  domain String?
  skill  String?

  sourceTopic String? @map("source_topic")

  /// IRT difficulty parameter, from the adaptive engine that was removed from
  /// the application. The column is still in the database and still empty;
  /// declaring it keeps Prisma's view of the table honest instead of treating
  /// it as drift to be dropped.
  irtB Float? @map("irt_b")

  /// Null means "not rated yet", which is not the same as "medium" — the
  /// question banks Sirius imports do not carry a difficulty, and recording a
  /// guess as a fact would mislead the adaptive module selection that will read
  /// this later.
  difficulty Difficulty?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practiceResponses PracticeResponse[]

  @@unique([testId, externalId])
  @@index([testId, module, order])
  @@index([skillId])
  @@map("questions")
}

// -----------------------------------------------------------------------------
// Attempts & results
// -----------------------------------------------------------------------------

/// An in-flight sitting of a test. Persisting this (rather than keeping it only
/// in React state) lets a student close the tab mid-module and resume, and
/// gives the timer a server-anchored start time that cannot be gamed by
/// reloading the page.
model TestAttempt {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  testId String @map("test_id")
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  status AttemptStatus @default(IN_PROGRESS)

  /// Answers so far: `{ "<questionId>": "B" }`.
  answers Json @default("{}")

  /// Questions the student flagged for review: `["<questionId>", …]`.
  flagged Json @default("[]")

  /*
   * MODULE STATE — a full Digital SAT is four timed modules, not one clock.
   *
   * `modulePlan` fixes which questions belong to which module when the sitting
   * starts: `[{ "module": 0, "questionIds": [...] }, …]`, where `module` indexes
   * `MOCK_MODULES` in `lib/mock.ts`. Deciding it up front is what lets the
   * server refuse an answer to a question that is not in the module currently
   * open, without a join on every autosave.
   *
   * Null on a single-module practice test, which has nothing to plan.
   */
  modulePlan Json? @map("module_plan")

  /// Position within `modulePlan` — not within `MOCK_MODULES`, because a
  /// sitting assembled from a thin bank may not contain all four.
  moduleIndex Int @default(0) @map("module_index")

  /*
   * When the *current* module started. This is the timer, and the only one:
   * the countdown in the browser renders this, and every write is checked
   * against it. A reload does not buy time and neither does a paused tab.
   *
   * Null on rows created before modules existed; those fall back to
   * `startedAt`.
   */
  moduleStartedAt DateTime? @map("module_started_at")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId, status])
  @@map("test_attempts")
}

/// The graded outcome of a completed attempt.
model TestResult {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  testId String @map("test_id")
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  /// Number of correct answers.
  score Int

  /// Total number of questions graded, so `score/total` survives later edits
  /// to the test.
  totalQuestions Int @map("total_questions")

  /// Estimated scaled score on the 400–1600 SAT scale.
  scaledScore Int? @map("scaled_score")

  /*
   * Section scores, 200–800 each. Adopted columns: both were already in the
   * database. Null on a result that did not cover that section — which is not
   * the same as scoring 200 in it, and must never be rendered as if it were.
   */
  rwScore   Int? @map("rw_score")
  mathScore Int? @map("math_score")

  /// Full per-question record:
  /// `{ "<questionId>": { "answer": "B", "correct": true } }`
  answersRecord Json @map("answers_record")

  /// Wall-clock seconds spent on the test.
  durationSeconds Int? @map("duration_seconds")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("test_results")
}

// -----------------------------------------------------------------------------
// Bilingual dictionary
// -----------------------------------------------------------------------------

/// English → Uzbek dictionary entry.
///
/// The MVP simulator reads `data/vocabulary.json` so lookups are instant and
/// need no network round-trip. This table is the same shape, for when the
/// dictionary outgrows a static file — seed it from the JSON with
/// `npm run db:seed`.
model Vocabulary {
  id String @id @default(cuid())

  /// Lower-cased lemma. Unique so imports can upsert.
  englishWord String @unique @map("english_word")

  /// Uzbek translation.
  translatedWord String @map("translated_word")

  /// Short English gloss shown above the translation.
  explanation String?

  /// Uzbek-language explanation.
  explanationUz String? @map("explanation_uz")

  partOfSpeech String? @map("part_of_speech")
  example      String?

  /*
   * `explanation` above *is* the definition — the English gloss shown over the
   * translation. A separate `definition` column would be the same sentence
   * stored twice, and the two would drift.
   */

  /// Words that could stand in for this one, for building recall exercises.
  synonyms String[] @default([])

  /// Grouping for study sets: "SAT Tier 1", "Science", "Rhetoric", …
  category String?

  createdAt DateTime @default(now()) @map("created_at")

  savedBy SavedWord[]

  @@index([category])

  @@map("vocabulary")
}

/// A word a student tapped in a passage and kept, for later revision.
model SavedWord {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The surface form as it appeared in the passage.
  word String

  /// Set when the word matched a dictionary entry.
  vocabularyId String?     @map("vocabulary_id")
  vocabulary   Vocabulary? @relation(fields: [vocabularyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, word])
  @@map("saved_words")
}

// -----------------------------------------------------------------------------
// Universities
// -----------------------------------------------------------------------------

/// A university in the explorer.
model University {
  id String @id @default(cuid())

  /*
   * IPEDS UNITID, from the College Scorecard API. Present on rows imported from
   * the API and null on the hand-curated international ones (Oxford, NYUAD, …),
   * which the US federal dataset does not cover. It is the upsert key for
   * re-imports, so a nightly refresh updates rows instead of duplicating them.
   */
  scorecardId Int? @unique @map("scorecard_id")

  /// Where the row came from: "curated" (hand-written) or "scorecard" (API).
  dataSource String @default("curated") @map("data_source")

  name    String  @unique
  country String?
  city    String?
  state   String?

  /// Share of applicants admitted, as a fraction: 0.043 = 4.3%.
  acceptanceRate Float? @map("acceptance_rate")

  /// Competitive score floors used for filtering.
  minSat   Int?   @map("min_sat")
  minIelts Float? @map("min_ielts")

  /// The TOEFL iBT equivalent of `minIelts`, where the university publishes one.
  minToefl Int? @map("min_toefl")

  /*
   * SAT section midpoints as reported to the Department of Education: the score
   * at which half of admitted students scored higher. `minSat` above is the
   * total a student compares against, derived from these two when the API
   * supplies them. Null for test-blind schools, which report no SAT at all.
   */
  satMath    Int? @map("sat_math")
  satReading Int? @map("sat_reading")

  /// Undergraduate enrolment. Useful context for "is this a big place?".
  studentSize Int? @map("student_size")

  /// Typical admitted GPA on the US 4.0 scale. Indicative, not a cut-off.
  averageGpa Float? @map("average_gpa")

  description String?

  /*
   * Free text and tag lists are stored per language rather than translated at
   * runtime: these are short curated strings, and machine-translating an
   * admissions requirement is how a student ends up believing something wrong.
   * The `*Uz` column falls back to the English one when it is empty.
   */
  descriptionUz String? @map("description_uz")

  /// Degree programmes the university is known for.
  popularMajors   String[] @default([]) @map("popular_majors")
  popularMajorsUz String[] @default([]) @map("popular_majors_uz")

  /// What this admissions office actually rewards in an applicant's profile.
  studentProfile   String? @map("student_profile")
  studentProfileUz String? @map("student_profile_uz")

  /// A campus photo. Null falls back to the generated cover in the UI.
  imageUrl String? @map("image_url")

  /// Extracurricular profile the admissions office rewards. A Postgres text[].
  extracurriculars   String[] @default([]) @map("extracurriculars")
  extracurricularsUz String[] @default([]) @map("extracurriculars_uz")

  /// Annual tuition in USD.
  tuitionUsd Int? @map("tuition_usd")

  /// True when the university meets full demonstrated need — the single most
  /// decision-relevant fact for most Sirius students.
  meetsFullNeed Boolean @default(false) @map("meets_full_need")

  worldRanking   Int?    @map("world_ranking")
  websiteUrl     String? @map("website_url")
  applicationDeadline DateTime? @map("application_deadline")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shortlistedBy UniversityShortlistEntry[]
  applicants    ApplicantProfile[]
  essays        Essay[]

  @@index([minSat])
  @@map("universities")
}

/// A university a student is tracking.
model UniversityShortlistEntry {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  note String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, universityId])
  @@map("university_shortlist_entries")
}

// -----------------------------------------------------------------------------
// Roadmap
// -----------------------------------------------------------------------------

/// A checklist item on the student's preparation roadmap, shown on the
/// dashboard. Seeded with a starter plan on first visit.
model RoadmapTask {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  detail String?

  /*
   * A stable key for the tasks Sirius seeds itself ("set-target", "first-test",
   * …). It is what makes the checklist translatable: the row stores English
   * text, and the UI prefers the dictionary entry for this slug when there is
   * one. Null for anything a student writes themselves, which is shown as
   * typed, in whatever language they typed it.
   */
  slug String?

  isDone Boolean   @default(false) @map("is_done")
  doneAt DateTime? @map("done_at")

  /// Sort position within the checklist.
  order Int @default(0)

  /// Optional deadline, e.g. an application due date.
  dueAt DateTime? @map("due_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isDone, order])
  @@map("roadmap_tasks")
}

// -----------------------------------------------------------------------------
// Study plan
// -----------------------------------------------------------------------------

/// A generated week-by-week preparation plan.
///
/// The plan is a *snapshot*, not a live view. It stores the four inputs it was
/// computed from and the projection it produced, because a student who moves
/// their exam date should be able to see that the old plan assumed something
/// else — a plan that silently recomputes itself is a plan nobody can argue
/// with. Regenerating writes a new row; the previous ones stay as history, and
/// the current plan is simply the newest.
///
/// The arithmetic lives in `lib/study-plan.ts` and is a pure function, so it can
/// be tested without a database and replaced with a proper IRT model later
/// without touching this table.
model StudyPlan {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /* The inputs, as they were when the plan was made. */
  currentScore       Int?     @map("current_score")
  targetScore        Int      @map("target_score")
  examDate           DateTime @map("exam_date")
  weeklyStudyMinutes Int      @map("weekly_study_minutes")

  /* What the model said would happen. */
  weeks           Int
  weeklyQuestions Int @map("weekly_questions")
  totalQuestions  Int @map("total_questions")

  /// Where the model expects the student to land by exam day. Null when they
  /// did not know their starting score — a projection from an unknown baseline
  /// is a number with no meaning, and showing one anyway is worse than showing
  /// nothing.
  projectedScore Int? @map("projected_score")

  /// True when the projection reaches the target.
  onTrack Boolean @map("on_track")

  /// Extra minutes a week the target would need. Zero when on track.
  shortfallMinutesPerWeek Int @default(0) @map("shortfall_minutes_per_week")

  /// True when the plan schedules fewer questions than the student has time
  /// for, because the question bank does not hold enough yet. Surfaced in the
  /// UI: the honest reason a light week is light.
  bankLimited Boolean @default(false) @map("bank_limited")

  createdAt DateTime @default(now()) @map("created_at")

  tasks StudyPlanTask[]

  @@index([userId, createdAt])
  @@map("study_plans")
}

/// One skill scheduled for one week: "40 questions of Words in Context, by the
/// 14th".
model StudyPlanTask {
  id String @id @default(cuid())

  planId String    @map("plan_id")
  plan   StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// 1-based week within the plan.
  week Int

  startDate DateTime @map("start_date")
  dueDate   DateTime @map("due_date")

  skillId String @map("skill_id")
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  targetQuestions Int @map("target_questions")

  /// DEAD COLUMN. Nothing reads it and nothing writes it any more. Progress is
  /// derived from the student's answers instead — `completedByTask` in
  /// `lib/study-plan.ts` says why a counter on the plan was the wrong shape.
  ///
  /// It is still declared because dropping a column is a destructive change and
  /// the Netlify build migrates *before* it deploys, so the drop belongs to a
  /// later deploy than the code that stopped using it. See *Deploying a schema
  /// change* in `DATABASE.md`, and open item 5 in `HANDOFF.md`.
  completedQuestions Int @default(0) @map("completed_questions")

  createdAt DateTime @default(now()) @map("created_at")

  /// Sessions opened from this task. Provenance only — a session credits
  /// nothing, because progress is counted from the answers themselves.
  practiceSessions PracticeSession[]

  @@unique([planId, week, skillId])
  @@index([planId, week])
  @@map("study_plan_tasks")
}

// -----------------------------------------------------------------------------
// Practice
// -----------------------------------------------------------------------------

/// A run through a handful of questions on one skill.
///
/// Practice is not a test, and the difference is the whole design: there is no
/// countdown, an answer is marked the moment it is given, and the explanation
/// appears immediately after. The timed, deferred-marking flow is the simulator
/// (`TestAttempt`), and the two share the grader in `lib/sat.ts` rather than
/// each having their own.
///
/// `questionIds` fixes the running order when the session starts, which is what
/// lets a student close the tab and come back to the same questions in the same
/// order. It is a JSON array of `Question.id`, the same shape and for the same
/// reason as `TestAttempt.answers`.
model PracticeSession {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Null for `MIXED` sessions, which span every topic and therefore belong to
  /// no single skill. Nullable rather than pointing at an arbitrary skill: a
  /// wrong attribution would poison the per-skill accuracy the study plan and
  /// the weak-topics list are built on.
  skillId String? @map("skill_id")
  skill   Skill?  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  source PracticeSource @default(SKILL)

  /// The study-plan task this session is working through, when it was opened
  /// from one. It records where the session came from and sizes it to what is
  /// left of the task; it does not credit anything, and it is `SetNull` rather
  /// than cascade because the answers outlive the plan that suggested them.
  planTaskId String?        @map("plan_task_id")
  planTask   StudyPlanTask? @relation(fields: [planTaskId], references: [id], onDelete: SetNull)

  /// The questions to ask, in order: `["<questionId>", …]`.
  questionIds Json @map("question_ids")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  responses PracticeResponse[]

  @@index([userId, startedAt])
  @@map("practice_sessions")
}

/// One answered question.
///
/// Written once, when the answer is given — practice has no "change your mind"
/// step, because the point of the mode is to find out what you know right now.
/// Re-answering the same question in the same session is refused rather than
/// overwritten, so the record of what was known when stays true.
model PracticeResponse {
  id String @id @default(cuid())

  sessionId String          @map("session_id")
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// What the student picked or typed. Null when they skipped it.
  answer    String?
  isCorrect Boolean @map("is_correct")

  /// Wall-clock seconds on this question. Recorded even though practice is
  /// untimed: "you knew it but it took four minutes" is a different fact from
  /// "you knew it", and the mastery model will want both.
  timeSpentSeconds Int @map("time_spent_seconds")

  answeredAt DateTime @default(now()) @map("answered_at")

  @@unique([sessionId, questionId])
  @@index([questionId])
  @@map("practice_responses")
}

// -----------------------------------------------------------------------------
// Admissions evidence
// -----------------------------------------------------------------------------

/// One admissions decision, as reported by an applicant.
///
/// A row is a *decision*, not a person: `universityId` plus `status` is the
/// unit. `applicantKey` is what stitches several rows back into one applicant,
/// so the profile view can show that the person who got into Yale was rejected
/// by Harvard. It is a pseudonymous handle ("2026-0142"), never a name.
///
/// NOTHING HERE IDENTIFIES ANYONE. Demographics are coarse buckets by design —
/// "state", "school type", "first generation" — because a shared SAT score plus
/// a city plus a rare award is identifying even without a name.
///
/// `isSample` marks the demonstration rows shipped with the repo. The UI badges
/// them, so a student never mistakes a made-up profile for a real outcome.
model ApplicantProfile {
  id String @id @default(cuid())

  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// Groups the rows that belong to one applicant. Not a foreign key: an
  /// applicant is not an account, and never becomes one.
  applicantKey String @map("applicant_key")

  status ApplicationStatus

  /// Application cycle, as the year the decision landed.
  year Int?

  satScore Int? @map("sat_score")
  actScore Int? @map("act_score")

  gpaUnweighted Float? @map("gpa_unweighted")
  gpaWeighted   Float? @map("gpa_weighted")

  major String?

  /// Coarse buckets only — see the note above. `{ state, schoolType, firstGen }`.
  demographics Json?

  /// `[{ title, role, hours, description }]`, in the applicant's own order.
  extracurriculars Json?

  /// `[{ title, level, year }]`, where level is school / state / national.
  awards Json?

  /// True for the demonstration rows in this repository.
  isSample Boolean @default(false) @map("is_sample")

  essays Essay[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([applicantKey, universityId])
  @@index([universityId, status])
  @@index([satScore])
  @@map("applicant_profiles")
}

/// An application essay, kept for students to read as craft rather than to copy.
model Essay {
  id String @id @default(cuid())

  /// The university this essay was written for. Null for a Common App personal
  /// statement, which goes to every school on the list.
  universityId String?     @map("university_id")
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  /// The decision this essay belongs to, when it is known.
  applicantProfileId String?           @map("applicant_profile_id")
  applicantProfile   ApplicantProfile? @relation(fields: [applicantProfileId], references: [id], onDelete: SetNull)

  prompt  String
  content String  @db.Text
  /// Stored rather than derived: the count a student compares against a limit
  /// is the one the essay was submitted with.
  wordCount Int    @map("word_count")

  /// What the essay is *about* — "Personal Identity", "Failure", "Community".
  topicTags String[] @default([]) @map("topic_tags")

  year Int?

  /// Behind the paywall. Drives the locked card state in the UI.
  isPremium Boolean @default(false) @map("is_premium")

  /// True for the demonstration rows in this repository.
  isSample Boolean @default(false) @map("is_sample")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([universityId])
  @@index([topicTags])
  @@map("essays")
}

/// A rung on the extracurricular ladder.
///
/// The tiers exist to answer the question every applicant actually has: "is
/// what I am doing good enough, and what does the next step look like?" A row
/// is a *kind* of involvement ("Club member", "Founded a non-profit"), not
/// something a specific student did.
model ActivityReference {
  id String @id @default(cuid())

  /// "Bronze I", "Bronze II", "Silver", "Gold", "Platinum".
  tier String

  /// "STEM", "Leadership", "Service", "Arts", "Athletics", "Research".
  category String

  title       String
  titleUz     String? @map("title_uz")
  description String?
  descriptionUz String? @map("description_uz")

  /// Share of applicants who report something of this kind, 0–1.
  ///
  /// Null means nobody has measured it, and the UI shows nothing rather than a
  /// number: "23% of applicants" is the kind of figure a student plans a year
  /// around, and inventing one to fill a card would be the worst lie on the
  /// page.
  participationRate Float? @map("participation_rate")

  /// Sort position inside its tier.
  order Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  /// Students who picked this rung for their own list.
  chosenBy UserActivity[]

  @@unique([tier, title])
  @@index([tier, order])
  @@index([category])
  @@map("activity_references")
}

/// One line of a student's own Common Application activities list.
///
/// The Common App allows ten activities and 150 characters to describe each,
/// and those two limits are the whole reason this table exists rather than a
/// free-text field: writing to the real constraint is the exercise. The limits
/// are enforced in `lib/actions/activities.ts` and mirrored here — 150 is a
/// `VarChar` so the database refuses an over-long description even if
/// something else writes it.
///
/// `position` is the student's own ordering, 1–10, which the Common App also
/// treats as meaningful: the first line is the one an admissions officer reads.
model UserActivity {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1–10, in the order the student wants them read.
  position Int

  title        String
  organisation String? @map("organisation")
  role         String?

  /// 150 characters, exactly as the Common App allows.
  description String? @db.VarChar(150)

  hoursPerWeek Int? @map("hours_per_week")
  weeksPerYear Int? @map("weeks_per_year")

  /// Optional link to the reference ladder, when the student picked from it.
  referenceId String?            @map("reference_id")
  reference   ActivityReference? @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, position])
  @@index([userId])
  @@map("user_activities")
}
